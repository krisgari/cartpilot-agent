ANTHROPIC_API_KEY=your-anthropic-key
CARTPILOT_MODEL=claude-sonnet-4-5-20250929

# --- Identity (required). Fail-closed: without this secret every protected route returns 503. ---
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CARTPILOT_JWT_SECRET=
CARTPILOT_JWT_ISSUER=
CARTPILOT_JWT_AUDIENCE=
# "production" (default) or "dev". Dev additionally accepts an X-Dev-Actor header (e.g. consumer:c1)
# so you can curl without minting tokens. NEVER use dev outside your laptop.
CARTPILOT_ENV=production

# Refund policy limits (enforced in code, not in the prompt)
CARTPILOT_AUTO_REFUND_LIMIT=25
CARTPILOT_MAX_AUTO_REFUNDS_30D=3

# Optional LLM-level tracing (works with no code change)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
